# Токен бота Telegram (получить у @BotFather)
BOT_TOKEN=

# ID канала (можно @username или числовой ID)
CHANNEL_ID=

# База данных (путь к файлу)
DATABASE_PATH=bot_data.db

# Тематика: ai (ИИ) или facts (история/астрономия/цитаты)
THEME=ai

# Название бренда на картинках (по умолч. из темы)
BRAND_NAME=

# Сколько новостей публиковать за один запуск
MAX_POSTS_PER_RUN=2

# Интервал между запусками в часах
SCHEDULE_INTERVAL_HOURS=3

# Секунды между постами (чтобы не флудить)
POST_DELAY_SECONDS=60

# Режим постов: image (только фото), video (только видео), mixed (случайно)
POST_MODE=mixed

# Длительность видео в секундах
VIDEO_DURATION=15

# Фоновая музыка для видео (генерируется процедурно, royalty-free)
MUSIC_ENABLED=true

# Стиль музыки: auto, calm, upbeat, mystery, epic
MUSIC_STYLE=auto

# Громкость музыки в видео (0.0 - 1.0)
MUSIC_VOLUME=0.35

# Свой аудиофайл (wav/mp3/m4a) вместо сгенерированного трека, например
# скачанный с https://mixkit.co (CC0) или https://incompetech.com (CC-BY)
# MUSIC_FILE=C:\music\mytrack.mp3

# Фиксированное зерно генерации музыки (пусто = случайное на каждый пост)
MUSIC_SEED=

# Русская озвучка видео (edge-tts, бесплатно, без API-ключа)
VOICE_ENABLED=true

# Голос: ru-RU-DmitryNeural (мужской) или ru-RU-SvetlanaNeural (женский)
VOICE_NAME=ru-RU-DmitryNeural
VOICE_FALLBACK_NAME=ru-RU-SvetlanaNeural

# Темп речи, например -10% (медленнее) или +20% (быстрее)
VOICE_RATE=+5%

# Максимум символов для озвучки (заголовок + начало описания)
VOICE_MAX_CHARS=200

# Сколько раз повторять запрос к TTS и пробовать второй голос, прежде чем
# отправить видео без озвучки
VOICE_RETRIES=3

# TikTok (официальный Content Posting API, нужен свой аккаунт разработчика
# на https://developers.tiktok.com/ и аудит скоупа video.publish)
# Без аудита TikTok публикует всё в приватном режиме.
TT_ENABLED=false

TT_ACCESS_TOKEN=
TT_REFRESH_TOKEN=
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_OPEN_ID=

# Приватность поста: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIERS, SELF_ONLY
TT_PRIVACY_LEVEL=SELF_ONLY

TT_MAX_CHARS=2200
TT_DISABLE_DUET=true
TT_DISABLE_COMMENT=false
TT_DISABLE_STITCH=true

# Подбирать тематические картинки (Pexels/Unsplash) для фона постов
USE_THEMED_IMAGES=true

# API ключи для поиска изображений (опционально, без них picsum.photos)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Instagram (опционально)
IG_USERNAME=
IG_PASSWORD=

# 2FA код для Instagram (если включена двухфакторка)
IG_2FA_CODE=

# Прокси для Instagram (формат: http://user:pass@host:port)
IG_PROXY=

# User-Agent для имитации устройства (если пусто — используется стандартный)
IG_USER_AGENT=
IG_DEVICE=
IG_LOCALE=ru_RU

# Количество попыток входа/публикации
IG_LOGIN_MAX_RETRIES=3
IG_POST_MAX_RETRIES=3
IG_RETRY_DELAY=10
IG_FEEDBACK_WAIT=300
